rules_version = '2';

// Security model for Nexus Student Companion.
//
// users/{uid} holds each user's profile document. Everything else — tasks,
// notes, exams, quizzes, focusDurations — lives as real-time subcollections
// nested under that same path (users/{uid}/tasks/{id}, etc. — see
// src/hooks/useUserCollection.js). Nesting under the owner's uid means
// ownership is enforced by the path itself: the wildcard rule below already
// covers all of them, no per-collection rule is needed as new ones are added.

function isSignedIn() {
  return request.auth != null;
}

function isOwner(uid) {
  return isSignedIn() && request.auth.uid == uid;
}

function isRecordOwner() {
  return isSignedIn() && request.auth.uid == resource.data.ownerId;
}

function willBeOwnedBySelf() {
  return isSignedIn() && request.auth.uid == request.resource.data.ownerId;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // --- User profile documents: users/{uid} ---
    // A user may only read and write their own profile document. No one
    // (including other authenticated users) can read someone else's profile.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false; // account deletion should go through a server flow

      // --- Future: per-user subcollections nested under their profile ---
      // e.g. users/{uid}/tasks/{taskId}, users/{uid}/notes/{noteId}, etc.
      // Nesting under the owner's uid means ownership is enforced by the
      // path itself — no need to re-check an ownerId field.
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- Future top-level collections that instead use an ownerId field ---
    // Kept here as the intended shape once these move off mock data.
    match /tasks/{taskId} {
      allow read, update, delete: if isRecordOwner();
      allow create: if willBeOwnedBySelf();
    }

    match /notes/{noteId} {
      allow read, update, delete: if isRecordOwner();
      allow create: if willBeOwnedBySelf();
    }

    match /quizAttempts/{attemptId} {
      allow read, update, delete: if isRecordOwner();
      allow create: if willBeOwnedBySelf();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
